  "components" : {
    "schemas" : {
      "UpdateEmployeeRequest" : {
        "type" : "object",
        "properties" : {
          "firstName" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          },
          "lastName" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          },
          "email" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 255,
            "minLength" : 0
          },
          "country" : {
            "type" : "string",
            "enum" : [ "US", "GB", "DE", "FR", "NL", "IN", "BR", "AU", "CA", "SG" ]
          },
          "department" : {
            "type" : "string",
            "enum" : [ "ENGINEERING", "PRODUCT", "SALES", "MARKETING", "FINANCE", "HUMAN_RESOURCES", "OPERATIONS", "CUSTOMER_SUPPORT", "LEGAL", "IT" ]
          },
          "jobTitle" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          },
          "hiredOn" : {
            "type" : "string",
            "format" : "date"
          }
        },
        "required" : [ "country", "department", "email", "firstName", "hiredOn", "jobTitle", "lastName" ]
      },
      "ApiError" : {
        "type" : "object",
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          },
          "fieldErrors" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/FieldError"
            }
          }
        }
      },
      "FieldError" : {
        "type" : "object",
        "properties" : {
          "field" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          }
        }
      },
      "SaveSalaryRequest" : {
        "type" : "object",
        "properties" : {
          "amount" : {
            "type" : "string",
            "description" : "Gross annual base salary, decimal string, 0.01–999999999.99",
            "example" : "85000.00",
            "minLength" : 1,
            "pattern" : "(?:0|[1-9][0-9]{0,8})(?:\\.[0-9]{1,2})?"
          },
          "currency" : {
            "type" : "string",
            "enum" : [ "USD", "GBP", "EUR", "INR", "BRL", "AUD", "CAD", "SGD" ]
          },
          "changeReason" : {
            "type" : "string",
            "maxLength" : 500,
            "minLength" : 0
          },
          "expectedVersion" : {
            "type" : [ "integer", "null" ],
            "format" : "int64",
            "description" : "Current salary version. Null only to establish a salary when none exists.",
            "minimum" : 0
          }
        },
        "required" : [ "amount", "changeReason", "currency" ]
      },
      "SalaryResponse" : {
        "type" : "object",
        "properties" : {
          "amount" : {
            "type" : "string",
            "example" : "85000.00"
          },
