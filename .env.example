# Synthetic, local-only defaults. Copy to .env and adjust; never commit real secrets.

POSTGRES_DB=salary_db
POSTGRES_USER=salary_app
POSTGRES_PASSWORD=change-me-for-local-dev

DB_HOST=postgres
DB_PORT=5432
DB_NAME=salary_db
DB_USER=salary_app
DB_PASSWORD=change-me-for-local-dev

# Demo HR login — synthetic credentials for the seeded demo account only.
DEMO_HR_USERNAME=hr.admin
DEMO_HR_PASSWORD=change-me-for-local-dev

# Seeding is explicit and opt-in; it never runs as a side effect of a normal boot.
SEED_ON_STARTUP=false
